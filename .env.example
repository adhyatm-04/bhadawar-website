# Copy these keys into the private server .env after configuring MSG91.
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_OTP_TEMPLATE_ID=your_approved_otp_template_id

# Verify customer email addresses through Resend. The sender must belong to a verified Resend domain.
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=Bhadawar Hotel <verify@your-verified-domain.example>

# Optional production data services. Required when BHADAWAR_ENV=production.
# For local development, leave DATABASE_URL and REDIS_URL empty to use SQLite and process-local state.
BHADAWAR_ENV=development
DATABASE_URL=
REDIS_URL=

# Local database location; optional. Keep the .db file private and out of Git.
# BHADAWAR_DB_PATH=./bhadawar.db
